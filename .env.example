COMPOSE_FILE=compose.yaml:net.yaml

DB_MYSQL_DATABASE=laravel
DB_MYSQL_PASSWORD=secret

NGINX_SERVER_YAML=/etc/nginx/yaml/servers.yaml
NGINX_SERVER_WATCH_CRT=/var/local/step
NGINX_SERVER_ADDRESS=

NODE_WS_CRT=/var/local/step
NODE_WS_REDIS_HOST=redis

STEP_CRT_STEP_INIT_NAME=Shop_CRT
STEP_CRT_STEP_INIT_DNS="shop.local"
STEP_CRT_STEP_INIT_SAN="localhost"
STEP_CRT_STEP_CA_URL=https://ca.local
STEP_CRT_STEP_FINGERPRINT=
STEP_CRT_STEP_KID=
STEP_CRT_STEP_RENEW_PERIOD=12h
STEP_PROVISIONER_PASSWORD_FILE=~/.step/provisioner_password

TEMPLATE_DIR=${HOME}/docker/templates

TEMPLATE_DB_MYSQL=${TEMPLATE_DIR}/db/mysql.yaml
TEMPLATE_DB_REDIS=${TEMPLATE_DIR}/db/redis.yaml
TEMPLATE_PHP_PHPFPM=${TEMPLATE_DIR}/php/phpfpm.yaml
TEMPLATE_NGINX_SERVER=${TEMPLATE_DIR}/nginx/server.yaml
TEMPLATE_NODE_VITE=${TEMPLATE_DIR}/node/vite.yaml
TEMPLATE_NODE_WS=${TEMPLATE_DIR}/node/ws.yaml
TEMPLATE_STEP_CRT=${TEMPLATE_DIR}/step/crt.yaml

VITE_VCONF_HMR_HOST=vite.shop.local
VITE_VCONF_HMR_CLIENT_PORT=443
VITE_VCONF_HTTPS_PATH=/var/local/step
