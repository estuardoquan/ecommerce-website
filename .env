_STEP=/var/local/step
_CRT=${_STEP}/site.crt

DB_MYSQL_DATABASE=laravel
DB_MYSQL_PASSWORD=secret


NGINX_SERVER_YAML=/etc/nginx/yaml/servers.yaml
NGINX_SERVER_WATCH_CRT=${_STEP}

NODE_WS_CRT=${_STEP}
NODE_WS_REDIS_HOST=redis

SERVER_20VLAN_ADDRESS=10.10.20.99

STEP_CRT_STEP_INIT_NAME=Shop_CRT
STEP_CRT_STEP_INIT_DNS="shop.local"
STEP_CRT_STEP_INIT_SAN=""
STEP_CRT_STEP_CA_URL=https://ca.local
STEP_CRT_STEP_FINGERPRINT=ff388ba16b325aaad30d867cd19dca4c6cf993a018966f409036c75c771f7bfb
STEP_CRT_STEP_KID=1MRjNdzlpgkNiWccVb9tDxvyasMVjBhokLAjoW__reM
STEP_CRT_STEP_RENEW_PERIOD=12h

STEP_PROVISIONER_PASSWORD_FILE=~/.step/provisioner_password

TEMPLATE_DIR=../../docker/templates

TEMPLATE_DB_MYSQL=${TEMPLATE_DIR}/db/mysql.yaml
TEMPLATE_DB_REDIS=${TEMPLATE_DIR}/db/redis.yaml
TEMPLATE_PHP_PHPFPM=${TEMPLATE_DIR}/php/phpfpm.yaml
